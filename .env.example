# Copy to `.env` ONLY if you prefer environment variables over kaggle.json.
# This project does not read .env itself; set them in PowerShell before downloading:
#   $env:KAGGLE_USERNAME = "your_kaggle_username"
#   $env:KAGGLE_KEY      = "your_kaggle_api_key"
# Optional fallback for hosting the model outside GitHub (public HTTPS URL, not secret):
#   MODEL_URL=https://example.com/flower_classifier.keras
KAGGLE_USERNAME=
KAGGLE_KEY=
MODEL_URL=
